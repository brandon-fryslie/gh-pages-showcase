{
  "name": "showcase-kit",
  "version": "0.1.0",
  "description": "Composable React components for project showcase pages on GitHub Pages.",
  "license": "MIT",
  "author": "Brandon Fryslie",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/showcase-kit.css"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@leaningtech/cheerpx": ">=1.0.0",
    "@xterm/addon-fit": ">=0.10.0",
    "@xterm/xterm": ">=5.5.0",
    "gsap": ">=3.12.0",
    "lenis": ">=1.1.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@leaningtech/cheerpx": {
      "optional": true
    },
    "@xterm/xterm": {
      "optional": true
    },
    "@xterm/addon-fit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@leaningtech/cheerpx": "^1.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "gsap": "^3.12.5",
    "lenis": "^1.1.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0"
  }
}
